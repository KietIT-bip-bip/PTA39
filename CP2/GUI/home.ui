   <string>
    QMainWindow {
        background-color: #121214;
    }
    
    QWidget#centralwidget {
        background-color: #121214;
    }
    
    /* Vùng nhập liệu phía trên */
    QWidget#widget {
        background-color: #1a1a1e;
        border-radius: 12px;
        padding: 10px;
    }
    
    QLabel#label_7 {
        color: #ffffff;
        font-family: &quot;Segoe UI&quot;, sans-serif;
        font-size: 16px;
        font-weight: bold;
        margin-bottom: 4px;
    }
    
    QTextEdit#textEdit {
        background-color: #26262b;
        color: #e2e2e6;
        border: 1px solid #3a3a40;
        border-radius: 8px;
        padding: 8px;
        font-family: &quot;Segoe UI&quot;, sans-serif;
        font-size: 14px;
    }
    QTextEdit#textEdit:focus {
        border: 1px solid #007acc;
    }
    
    /* Thanh nút bấm chức năng (Icon) */
    QPushButton[name^=&quot;pushButton_&quot;] {
        background-color: #26262b;
        color: #007acc;
        border: 1px solid #3a3a40;
        border-radius: 6px;
        min-width: 70px;
        min-height: 32px;
        font-family: &quot;Segoe UI&quot;, sans-serif;
        font-weight: bold;
        font-size: 11px;
    }
    QPushButton[name^=&quot;pushButton_&quot;]:hover {
        background-color: #007acc;
        color: #ffffff;
        border: 1px solid #007acc;
    }
    QPushButton[name^=&quot;pushButton_&quot;]:pressed {
        background-color: #005999;
    }
    
    /* Khu vực danh sách thẻ ở dưới */
    QWidget#widget_2, QWidget#widget_4, QWidget#widget_6 {
        background-color: #1a1a1e;
        border: 1px solid #26262b;
        border-radius: 12px;
        padding: 12px;
    }
    
    /* Tiêu đề của từng thẻ */
    QLabel#label, QLabel#label_3, QLabel#label_5 {
        color: #007acc;
        font-family: &quot;Segoe UI&quot;, sans-serif;
        font-size: 15px;
        font-weight: bold;
    }
    
    /* Nội dung văn bản bên trong thẻ */
    QLabel#label_2, QLabel#label_4, QLabel#label_6 {
        color: #a1a1aa;
        font-family: &quot;Segoe UI&quot;, sans-serif;
        font-size: 13px;
        line-height: 18px;
    }
    
    /* Nút bấm Edit nằm trong thẻ */
    QPushButton#pushButton, QPushButton#pushButton_2, QPushButton#pushButton_3 {
        background-color: #26262b;
        color: #e2e2e6;
        border: 1px solid #3a3a40;
        border-radius: 6px;
        padding: 6px 16px;
        font-family: &quot;Segoe UI&quot;, sans-serif;
        font-size: 13px;
        font-weight: 500;
    }
    QPushButton#pushButton:hover, QPushButton#pushButton_2:hover, QPushButton#pushButton_3:hover {
        background-color: #323238;
        border: 1px solid #4e4e56;
        color: #ffffff;
    }
    QPushButton#pushButton:pressed, QPushButton#pushButton_2:pressed, QPushButton#pushButton_3:pressed {
        background-color: #202024;
    }
   </string>
